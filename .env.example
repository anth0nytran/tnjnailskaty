# ──────────────────────────────────────────────
# Resend — appointment request emails
# Domain must be verified in Resend dashboard.
# ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Where booking emails come FROM (must be on a verified Resend domain)
RESEND_FROM="T&J Nails <bookings@tjnailskaty.com>"

# Where booking emails are delivered (the salon owners)
RESEND_TO=jenny@tjnailskaty.com

# Optional: BCC every lead to your address for monitoring
RESEND_BCC=

# Optional: Reply-To override (defaults to the customer's email)
RESEND_REPLY_TO=

# ──────────────────────────────────────────────
# Public site URL (no trailing slash)
# ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tjnailskaty.com
